generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GalleryCategory {
  FOOD
  INTERIOR
  PEOPLE
  EVENTS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  isFeatured   Boolean      @default(false)
  featuredOrder Int?
  dietaryTags  String[]
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, displayOrder])
}

model GalleryImage {
  id           String          @id @default(uuid()) @db.Uuid
  url          String
  title        String?
  caption      String?
  category     GalleryCategory
  displayOrder Int             @default(0)
  isFeatured   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, displayOrder])
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  role         String
  bio          String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews Review[]
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  customerName    String
  email           String
  phone           String
  reservationDate DateTime
  reservationTime String
  guestCount      Int
  specialRequests String?
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, reservationDate])
  @@index([reservationDate])
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  customerName String
  rating       Int
  comment      String
  status       ReviewStatus @default(PENDING)
  isFeatured   Boolean      @default(false)
  teamMemberId String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([status, isFeatured])
  @@index([teamMemberId])
}

model RestaurantSettings {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantName String
  tagline        String?
  description    String?
  address        String
  phone          String
  email          String
  instagramUrl   String?
  facebookUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OpeningHour {
  id        String    @id @default(uuid()) @db.Uuid
  dayOfWeek DayOfWeek @unique
  openTime  String?
  closeTime String?
  isClosed  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
